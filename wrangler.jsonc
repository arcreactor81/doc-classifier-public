{
  // The shared configuration. The D1 database id and Secrets Store id are placeholders: CI only builds this file with
  // `wrangler deploy --dry-run`. Put your own resource ids here before deploying it anywhere.
  "name": "doc-classifier-generic",
  "main": "core/server/worker.ts",
  "compatibility_date": "2026-09-22",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "doc-classifier-generic",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "doc-classifier-generic-artifacts"
    }
  ],
  "workflows": [
    {
      "binding": "DOCUMENT_WORKFLOW",
      "name": "doc-classifier-generic-document",
      "class_name": "DocumentWorkflow"
    }
  ],
  "secrets_store_secrets": [
    {
      "binding": "OPENAI_API_KEY",
      "store_id": "00000000000000000000000000000000",
      "secret_name": "OPENAI_API_KEY"
    },
    {
      "binding": "JEV_API_KEY",
      "store_id": "00000000000000000000000000000000",
      "secret_name": "JEV_API_KEY"
    }
  ],
  "vars": {
    "PROJECT_ID": "generic",
    "MODEL_CALLS_ENABLED": "false",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "BUILD_COMMIT": "unversioned",
    // A JSON array of Cloudflare Access user IDs (the JWT `sub`), the owner first. Health reads NOT READY until one is listed.
    "DEFINITION_EDITORS": "[]",
    // Trusted users (DECISIONS 150): Access user IDs in the same format, exempt from the per-person daily caps only. May be empty.
    "TRUSTED_USERS": "[]"
  },
  "env": {
    "generic": {
      "name": "doc-classifier-generic",
      "main": "core/server/worker.ts",
      "compatibility_date": "2026-09-22",
      "workers_dev": false,
      "preview_urls": false,
      "observability": {
        "enabled": true,
        "traces": {
          "enabled": true
        }
      },
      "assets": {
        "directory": "dist",
        "binding": "ASSETS",
        "run_worker_first": true,
        "not_found_handling": "single-page-application"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "doc-classifier-generic",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "ARTIFACTS",
          "bucket_name": "doc-classifier-generic-artifacts"
        }
      ],
      "workflows": [
        {
          "binding": "DOCUMENT_WORKFLOW",
          "name": "doc-classifier-generic-document",
          "class_name": "DocumentWorkflow"
        }
      ],
      "secrets_store_secrets": [
        {
          "binding": "OPENAI_API_KEY",
          "store_id": "00000000000000000000000000000000",
          "secret_name": "OPENAI_API_KEY"
        },
        {
          "binding": "JEV_API_KEY",
          "store_id": "00000000000000000000000000000000",
          "secret_name": "JEV_API_KEY"
        }
      ],
      "vars": {
        "PROJECT_ID": "generic",
        "MODEL_CALLS_ENABLED": "false",
        "ACCESS_TEAM_DOMAIN": "",
        "ACCESS_AUD": "",
        "BUILD_COMMIT": "unversioned",
        // A JSON array of Cloudflare Access user IDs (the JWT `sub`), the owner first. Health reads NOT READY until one is listed.
        "DEFINITION_EDITORS": "[]",
        // Trusted users (DECISIONS 150): Access user IDs in the same format, exempt from the per-person daily caps only. May be empty.
        "TRUSTED_USERS": "[]"
      },
      "tsconfig": "tsconfig.worker.json"
    }
  },
  "tsconfig": "tsconfig.worker.json",
  "alias": {
    "project-pack": "./projects/generic/project.json"
  }
}
