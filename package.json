{
  "name": "doc-classifier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "test": "node --test --test-reporter=spec \"core/**/*.test.ts\" \"scripts/*.test.mjs\" \"scripts/fixtures/*.test.mjs\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "check": "node scripts/check.mjs",
    "build": "node scripts/check.mjs",
    "dev": "vite",
    "dev:api": "wrangler dev --env generic",
    "test:worker": "node scripts/worker-smoke.mjs",
    "check:ui": "node scripts/ui-harness/run-flows.mjs",
    "deploy:owner": "node scripts/deploy.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "jsonc-parser": "3.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "wrangler": "4.149.0"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/newsreader": "5.2.10",
    "@zip.js/zip.js": "2.17.0",
    "fast-xml-parser": "5.11.1",
    "jose": "6.2.12",
    "pdfjs-dist": "6.3.289",
    "three": "0.128.0"
  }
}
